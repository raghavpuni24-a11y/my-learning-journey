### ✅ Code — Ready to run

```python
# ── LISTS ────────────────────────────────────────────
marks = [85, 92, 78]          # create
print(marks[0])               # 85  → indexing
print(marks[-1])              # 78  → negative index (last item)
print(marks[0:2])             # [85, 92] → slicing

marks.append(99)              # add to end
marks.insert(1, 88)           # insert at index 1
marks.remove(78)              # remove by value
marks.pop()                   # remove last item
marks.pop(0)                  # remove at index 0
marks.sort()                  # sort in-place
marks.reverse()               # reverse in-place
print(len(marks))             # length
print(92 in marks)            # True → membership check

# list of mixed types (Python allows this!)
student = ["Raghav", 20, True, 9.1]

# nested list (like 2D array in Java)
matrix = [[1, 2], [3, 4], [5, 6]]
print(matrix[1][0])           # 3


# ── TUPLES ────────────────────────────────────────────
dob = (2003, 8, 15)           # create
print(dob[0])                 # 2003
print(dob[1:])                # (8, 15) → slicing works same

# single item tuple → the comma is MANDATORY
one = (42,)                   # this is a tuple
not_tuple = (42)              # this is just int 42 !!

# tuple unpacking (very pythonic)
year, month, day = dob
print(year)                   # 2003

# tuples are faster and use less memory than lists
# use them for data that should NOT change

# convert between them
t = tuple(marks)              # list → tuple
l = list(dob)                 # tuple → list


# ── COMMON OPERATIONS (both work same) ────────────────
for item in marks:            # iteration
    print(item)

print(min(marks), max(marks)) # min / max
print(marks.count(92))        # count occurrences
print(marks.index(92))        # find index of value
```

